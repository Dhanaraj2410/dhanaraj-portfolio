# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local database (MySQL is the default; keep DB_PASSWORD only in your ignored .env)
DB_ENGINE=mysql
DB_NAME=portfolio_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_SSL=False
# DB_SSL_CA=path-to-provider-ca-certificate.pem
# For a managed database, use DATABASE_URL or set the DB_* values above.
# DATABASE_URL=postgres://user:password@localhost:5432/portfolio_db

# OpenAI API (for AI Chatbot & Resume Analyzer)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# GitHub Integration
# Your GitHub username (public, used for API calls)
GITHUB_USERNAME=Dhanaraj2410
# Optional: Personal access token for higher rate limits (5000/hr vs 60/hr)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

